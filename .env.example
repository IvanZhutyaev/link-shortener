# Server
PORT=3000

# PostgreSQL (local). In Docker Compose these hostnames are overridden to service names.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/link_shortener

# Redis
REDIS_URL=redis://localhost:6379

# Public origin used to build shortUrl in API responses
BASE_URL=http://localhost:3000

# Original URL cache TTL (1 hour)
REDIS_TTL_SECONDS=3600

# Frontend (Vite). Browser talks to the backend on this URL.
VITE_API_URL=http://localhost:3000
